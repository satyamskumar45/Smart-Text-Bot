# Root Git ignore for production-ready repository

# Python virtual environments
.venv/
backend/.venv/
venv/
ENV/

# Python cache and build artifacts
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Node / frontend build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/

# Logs and caches
*.log
logs/
.pytest_cache/
.mypy_cache/
.cache/
.ruff_cache/
.coverage
.coverage.*
coverage/
htmlcov/
pytestdebug.log
*.tmp
*.temp
*.pid
*.seed
*.tsbuildinfo
.eslintcache

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Environment files
backend/.env
backend/.env.local
backend/.env.*.local
.env
.env.local
.env.*.local

# Deployment artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
