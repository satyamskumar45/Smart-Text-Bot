# Backend example environment variables (copy to backend/.env when deploying)
MONGO_URI=mongodb://username:password@host:27017
MONGO_DB_NAME=smarttextbot
JWT_SECRET_KEY=replace_with_secure_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
REMEMBER_ME_EXPIRES_DAYS=30
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=90
LOG_LEVEL=INFO
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
TESSERACT_PATH=
TESSERACT_WINDOWS_FALLBACK=C:\Program Files\Tesseract-OCR\tesseract.exe# Database configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=smarttextbot
DB_POOL_SIZE=5

# JWT configuration
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
REMEMBER_ME_EXPIRES_DAYS=30
JWT_COOKIE_NAME=smarttextbot_refresh

# Guest mode configuration
GUEST_SESSION_LIFETIME_HOURS=24

# Rate limiter
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=90

# Optional AI keys
GROQ_API_KEY=
OPENAI_API_KEY=
LOG_LEVEL=INFO