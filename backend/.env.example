# Database configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=smarttextbot
DB_POOL_SIZE=5

# JWT configuration
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
REMEMBER_ME_EXPIRES_DAYS=30
JWT_COOKIE_NAME=smarttextbot_refresh

# Guest mode configuration
GUEST_SESSION_LIFETIME_HOURS=24

# Rate limiter
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=90

# Optional AI keys
GROQ_API_KEY=
OPENAI_API_KEY=
LOG_LEVEL=INFO